include(FindPackageHandleStandardArgs)
set(Boost_VERSION 1.88.0)
foreach(_component IN LISTS Boost_FIND_COMPONENTS)
	if(TARGET Boost::${_component})
		set(Boost_${_component}_FOUND TRUE)
	endif()
endforeach()
if(TARGET Boost::headers)
	set(Boost_FOUND_TARGET TRUE)
endif()
find_package_handle_standard_args(Boost REQUIRED_VARS Boost_FOUND_TARGET VERSION_VAR Boost_VERSION HANDLE_COMPONENTS)
