include(FindPackageHandleStandardArgs)
set(OPENSSL_VERSION 4.1.0)
foreach(_component IN LISTS OpenSSL_FIND_COMPONENTS)
	if(TARGET OpenSSL::${_component})
		set(OpenSSL_${_component}_FOUND TRUE)
	endif()
endforeach()
if(TARGET OpenSSL::Crypto)
	set(OPENSSL_FOUND_TARGET TRUE)
endif()
find_package_handle_standard_args(OpenSSL REQUIRED_VARS OPENSSL_FOUND_TARGET VERSION_VAR OPENSSL_VERSION HANDLE_COMPONENTS)
